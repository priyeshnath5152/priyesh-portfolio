# Copy this file to .env.local, fill in what you use, then restart `npm start`.
# Leave a pair empty to keep that alert switched off.

# WhatsApp alerts via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
REACT_APP_CALLMEBOT_PHONE=
REACT_APP_CALLMEBOT_APIKEY=

# Telegram alerts via your own bot (create it with @BotFather)
REACT_APP_TELEGRAM_BOT_TOKEN=
REACT_APP_TELEGRAM_CHAT_ID=
